    given-names: Rodion
repository-code: "https://github.com/nefayran/protocell-genesis"
url: "https://nefayran.github.io/protocell-genesis/"
license: MIT
date-released: 2026-09-27
keywords:
  - webgpu
  - molecular-dynamics
  - coarse-grained
  - self-assembly
  - origin-of-life
  - negative-results
